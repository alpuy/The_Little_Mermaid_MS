diff --git a/core/z80/z80.c b/core/z80/z80.c
index 74d5053..033d3d0 100644
--- a/core/z80/z80.c
+++ b/core/z80/z80.c
@@ -1,3 +1,4 @@
+#include <string.h>
 /*****************************************************************************
  *
  *   z80.c
@@ -3417,6 +3418,22 @@ void z80_reset(void)
 /****************************************************************************
  * Run until given cycle count 
  ****************************************************************************/
+/* debug hooks (test harness) */
+unsigned int dbg_enable = 0;
+unsigned int dbg_hits[65536];
+unsigned int dbg_count_en = 0;
+unsigned short dbg_trace[65536];
+unsigned int dbg_trace_pos = 0;
+unsigned int dbg_prof_interval = 0, dbg_prof_acc = 0, dbg_prof_last = 0;
+unsigned int dbg_prof_n = 0, dbg_prof_cap = 0;
+unsigned int *dbg_prof_buf = 0;
+unsigned int dbg_tag_addr = 0;       /* RAM byte stored with each sample (bits 16-23) */
+unsigned int dbg_stop_pc = 0x10000;  /* when PC reaches it: dbg_stopped = 1 and the frame ends early */
+unsigned int dbg_stopped = 0;
+unsigned int dbg_snap_pc = 0x10000;  /* copy RAM C000-C7FF to dbg_snap_buf each time PC hits it */
+unsigned char *dbg_snap_buf = 0;
+unsigned int dbg_snap_n = 0, dbg_snap_cap = 0;
+
 void z80_run(unsigned int cycles)
 {
   while( Z80.cycles < cycles )
@@ -3429,6 +3446,32 @@ void z80_run(unsigned int cycles)
     }
 
     Z80.after_ei = FALSE;
+    if (dbg_enable)
+    {
+      unsigned int pc = PCD & 0xFFFF;
+      if (dbg_count_en) dbg_hits[pc]++;
+      dbg_trace[dbg_trace_pos++ & 0xFFFF] = pc;
+      if (dbg_prof_interval)
+      {
+        unsigned int c = Z80.cycles;
+        dbg_prof_acc += (c >= dbg_prof_last) ? c - dbg_prof_last : c;
+        dbg_prof_last = c;
+        if (dbg_prof_acc >= dbg_prof_interval)
+        {
+          dbg_prof_acc -= dbg_prof_interval;
+          if (dbg_prof_n < dbg_prof_cap)
+            dbg_prof_buf[dbg_prof_n++] = pc | ((unsigned int)z80_readmap[(dbg_tag_addr >> 10) & 0x3F][dbg_tag_addr & 0x3FF] << 16);
+        }
+      }
+      if (pc == dbg_snap_pc && dbg_snap_n < dbg_snap_cap)
+      {
+        unsigned char *d = dbg_snap_buf + dbg_snap_n * 2048;
+        memcpy(d, z80_readmap[0x30], 1024);
+        memcpy(d + 1024, z80_readmap[0x31], 1024);
+        dbg_snap_n++;
+      }
+      if (pc == dbg_stop_pc) { dbg_stopped = 1; dbg_stop_pc = 0x10000; Z80.cycles = cycles; return; }
+    }
     R++;
     EXEC_INLINE(op,ROP());
   }
